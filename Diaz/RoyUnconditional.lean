  rfl

/-- Roy's strong six exponentials theorem in the quotient form, with no hypothesis. -/
theorem strong_six_exponentials_quotient_form_unconditional :
    ∀ l₀ l₁ l₂ l₃ : ℂ, l₀ ∈ LogAlgTilde → l₁ ∈ LogAlgTilde → l₂ ∈ LogAlgTilde →
      l₃ ∈ LogAlgTilde →
      (∀ a b : ℂ, a ∈ Qbar → b ∈ Qbar → a * l₀ + b * l₁ = 0 → a = 0 ∧ b = 0) →
      (∀ a b c : ℂ, a ∈ Qbar → b ∈ Qbar → c ∈ Qbar → a * l₀ + b * l₂ + c * l₃ = 0 →
        a = 0 ∧ b = 0 ∧ c = 0) →
      ¬ (l₁ * l₂ / l₀ ∈ LogAlgTilde ∧ l₁ * l₃ / l₀ ∈ LogAlgTilde) :=
  strong_six_exponentials_iff_quotient_form.mp strongSixExponentials

